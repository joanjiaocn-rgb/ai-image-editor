# Public canonical site URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://imageeditor.website

# Black Forest Labs server-only key. Never expose this value in NEXT_PUBLIC_*.
BFL_API_KEY=

# Stripe server-only keys for future Checkout and webhook routes.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
